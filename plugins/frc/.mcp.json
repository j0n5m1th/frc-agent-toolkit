{
  "mcpServers": {
    "nt4": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "--frozen",
        "--no-dev",
        "--python",
        "3.13",
        "frc-mcp",
        "nt4"
      ],
      "env": {
        "NT4_HOST": "${user_config.nt4_host}",
        "NT4_READ_ONLY": "${user_config.nt4_read_only}",
        "FRC_LEARNING_MODE": "${user_config.learning_mode}"
      }
    },
