{
  "mcpServers": {
    "nt4": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "--frozen",
        "--no-dev",
        "--python",
        "3.13",
        "frc-mcp",
        "nt4"
      ],
      "env": {
        "NT4_HOST": "${user_config.nt4_host}",
        "NT4_READ_ONLY": "${user_config.nt4_read_only}"
      }
    },
    "wpilog": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "--frozen",
        "--no-dev",
        "--python",
        "3.13",
        "frc-mcp",
        "wpilog"
      ],
      "env": {
        "WPILOG_DIR": "${CLAUDE_PROJECT_DIR}",
        "WPILOG_ALLOW_OUTSIDE": "${user_config.read_outside_logs}"
      }
    },
    "sim": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
